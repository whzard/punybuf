@builtin
Builtin = Builtin

@builtin
@flags(64)
Flags = Flags

@builtin
@flags(4)
MiniFlags = MiniFlags

BooleanFlag = {
	field: Builtin
	field_2: Flags
	flags_1: Flags.{
		native_flag?
		native_flag_value?: Builtin
		@extension
		extension_flag?
		@extension
		extension_flag_value?: Builtin
	}
	flags_2: Flags.{
		another_native_flag?
		@extension
		legal_non_blocking_flag?
	}
}

Exhausted = {
	field: Builtin
	field_2: Flags
	flags_1: MiniFlags.{
		native_flag?
		native_flag_value?: Builtin
		@extension
		extension_flag?
		@extension
		extension_flag_value?: Builtin
	}
	flags_2: Flags.{
		another_native_flag?
		@extension
		legal_non_blocking_flag?
	}
}

MarkedSealed = {
	field: Builtin
	field_2: Flags
	@sealed
	flags_1: Flags.{
		native_flag?
		native_flag_value?: Builtin
		@extension
		extension_flag?
		@extension
		extension_flag_value?: Builtin
	}
	flags_2: Flags.{
		another_native_flag?
		@extension
		illegal_blocking_flag?: Builtin
	}
}